{
  "name": "vgc-mobile-v1",
  "version": "0.1.0",
  "description": "Pokémon Champions team builder & damage calculator PWA (Reg M-B)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:dex": "tsx scripts/build-dex.ts",
    "data:regulation": "tsx scripts/build-regulation.ts",
    "data:all": "npm run data:regulation && npm run data:dex && npm run data:sprites",
    "data:sprites": "tsx scripts/fetch-sprites.ts",
    "data:usage": "tsx scripts/build-usage.ts",
    "data:tournaments": "tsx scripts/build-tournaments.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.11.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
